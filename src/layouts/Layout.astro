---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = "Kalkulator wynagrodzeń 2026 — oblicz wynagrodzenie netto z brutto. Składki ZUS, zdrowotna, PIT, koszt pracodawcy.",
  canonical,
} = Astro.props;

const siteUrl = "https://kalkulatorwynagrodzen.pl";
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="author" content="Mottalib Radif" />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Kalkulator Wynagrodzen",
      "url": "https://kalkulatorwynagrodzen.pl",
      "logo": "https://kalkulatorwynagrodzen.pl/favicon.svg",
      "founder": {
        "@type": "Person",
        "name": "Mottalib Radif"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Mottalib Radif",
      "jobTitle": "Ekspert ds. Finansów Osobistych i Technologii Podatkowej",
      "description": "Absolwent MBA INSEAD, pasjonat polskich finansów osobistych. Specjalizacja w PIT, ZUS i optymalizacji wynagrodzeń.",
      "alumniOf": { "@type": "EducationalOrganization", "name": "INSEAD" },
      "image": "https://kalkulatorwynagrodzen.pl/team/mottalib-radif.jpg",
      "url": "https://kalkulatorwynagrodzen.pl/o-nas/"
    })} />

    <!-- Plausible Analytics -->
    <script defer data-domain="kalkulatorwynagrodzen.pl" src="https://plausible.io/js/script.js"></script>

    <!-- TODO: Replace G-XXXXXXXXXX with your real GA4 Measurement ID from https://analytics.google.com -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-blue-700 focus:rounded-lg focus:shadow-lg focus:ring-2 focus:ring-blue-500">Skip to content</a>
    <!-- Pasek flagi polskiej -->
    <div class="polish-flag-bar"></div>

    <!-- Nagłówek -->
    <header class="gradient-header text-white py-4 shadow-lg relative">
      <div class="max-w-6xl mx-auto px-4 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold hover:opacity-90 transition-opacity">
          KalkulatorWynagrodzen.pl
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex gap-6 text-sm">
          <a href="/" class="hover:underline underline-offset-4">Kalkulator</a>
          <a href="/guides/" class="hover:underline underline-offset-4">Poradniki</a>
          <a href="/faq/" class="hover:underline underline-offset-4">FAQ</a>
          <a href="/regulamin/" class="hover:underline underline-offset-4">Regulamin</a>
          <a href="/prywatnosc/" class="hover:underline underline-offset-4">Prywatność</a>
        </nav>

        <!-- Mobile hamburger button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex flex-col justify-center items-center w-10 h-10 rounded-lg hover:bg-white/20 transition-colors"
          aria-label="Otwórz menu"
          aria-expanded="false"
        >
          <span class="hamburger-line block w-6 h-0.5 bg-white rounded transition-all duration-300"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-white rounded mt-1.5 transition-all duration-300"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-white rounded mt-1.5 transition-all duration-300"></span>
        </button>
      </div>

      <!-- Mobile nav menu -->
      <nav
        id="mobile-menu"
        class="md:hidden hidden absolute top-full left-0 right-0 bg-[var(--color-primary-dark)] shadow-lg z-50"
      >
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-4 text-sm">
          <a href="/" class="hover:underline underline-offset-4 py-2 border-b border-white/20">Kalkulator</a>
          <a href="/guides/" class="hover:underline underline-offset-4 py-2 border-b border-white/20">Poradniki</a>
          <a href="/faq/" class="hover:underline underline-offset-4 py-2 border-b border-white/20">FAQ</a>
          <a href="/regulamin/" class="hover:underline underline-offset-4 py-2 border-b border-white/20">Regulamin</a>
          <a href="/prywatnosc/" class="hover:underline underline-offset-4 py-2">Prywatność</a>
        </div>
      </nav>
    </header>

    <!-- Treść -->
    <main id="main-content" class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <!-- Stopka -->
    <footer class="bg-gray-800 text-gray-300 py-8 mt-auto">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-6">
          <div>
            <h3 class="text-white font-bold mb-3">KalkulatorWynagrodzen.pl</h3>
            <p class="text-sm">
              Bezpłatny kalkulator wynagrodzeń brutto-netto na rok 2026.
              Oblicz swoje wynagrodzenie z uwzględnieniem składek ZUS,
              składki zdrowotnej i podatku PIT.
            </p>
          </div>
          <div>
            <h3 class="text-white font-bold mb-3">Przydatne linki</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/" class="hover:text-white transition-colors">Kalkulator wynagrodzeń</a></li>
              <li><a href="/guides/" class="hover:text-white transition-colors">Poradniki</a></li>
              <li><a href="/faq/" class="hover:text-white transition-colors">Najczęściej zadawane pytania</a></li>
              <li><a href="/regulamin/" class="hover:text-white transition-colors">Regulamin serwisu</a></li>
              <li><a href="/prywatnosc/" class="hover:text-white transition-colors">Polityka prywatności</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-bold mb-3">Informacje</h3>
            <p class="text-sm">
              Obliczenia oparte na przepisach obowiązujących w 2026 roku.
              Kalkulator ma charakter informacyjny i nie stanowi porady podatkowej.
            </p>
          </div>
        </div>
        <div class="border-t border-gray-700 pt-4 text-center text-sm">
          <p>&copy; {new Date().getFullYear()} KalkulatorWynagrodzen.pl — Wszelkie prawa zastrzeżone.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        if (btn && menu) {
          btn.addEventListener('click', function() {
            var isOpen = !menu.classList.contains('hidden');
            menu.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', String(!isOpen));
            btn.setAttribute('aria-label', isOpen ? 'Otwórz menu' : 'Zamknij menu');
            var lines = btn.querySelectorAll('.hamburger-line');
            if (!isOpen) {
              lines[0].style.transform = 'rotate(45deg) translate(4px, 4px)';
              lines[1].style.opacity = '0';
              lines[2].style.transform = 'rotate(-45deg) translate(4px, -4px)';
            } else {
              lines[0].style.transform = '';
              lines[1].style.opacity = '1';
              lines[2].style.transform = '';
            }
          });
        }
      });
    </script>
  </body>
</html>

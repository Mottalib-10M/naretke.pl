---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const guides = [
  {
    title: "Progi podatkowe PIT 2026",
    description: "Dowiedz się, jak działają progi podatkowe 12% i 32% oraz jak wpływają na Twoje wynagrodzenie netto.",
    href: "/guides/progi-podatkowe-pit/",
    icon: "📊",
  },
  {
    title: "Składki ZUS pracownika",
    description: "Szczegółowy przewodnik po składkach na ubezpieczenia społeczne odprowadzanych przez pracownika.",
    href: "/guides/skladki-zus-pracownik/",
    icon: "🏦",
  },
  {
    title: "Składka zdrowotna",
    description: "Jak naliczana jest składka zdrowotna i dlaczego nie można jej odliczyć od podatku?",
    href: "/guides/skladka-zdrowotna/",
    icon: "🏥",
  },
  {
    title: "Kwota wolna od podatku",
    description: "Wszystko o kwocie wolnej 30 000 PLN - kto z niej korzysta i jak wpływa na wynagrodzenie.",
    href: "/guides/kwota-wolna-od-podatku/",
    icon: "💰",
  },
  {
    title: "Umowa o pracę vs B2B",
    description: "Porównanie zatrudnienia na etacie i współpracy B2B - koszty, podatki, ZUS i wynagrodzenie netto.",
    href: "/guides/umowa-o-prace-vs-b2b/",
    icon: "⚖️",
  },
  {
    title: "Koszty uzyskania przychodu",
    description: "Czym są koszty uzyskania przychodu i jak zmniejszają Twój podatek dochodowy?",
    href: "/guides/koszty-uzyskania-przychodu/",
    icon: "📝",
  },
  {
    title: "Ulga dla młodych (do 26 lat)",
    description: "Zerowy PIT dla osób do 26 roku życia - warunki, limity i sposób rozliczenia.",
    href: "/guides/ulga-dla-mlodych/",
    icon: "🎓",
  },
  {
    title: "Negocjowanie wynagrodzenia",
    description: "Praktyczne wskazówki, jak skutecznie negocjować pensję w Polsce - od rozmowy kwalifikacyjnej po podwyżkę.",
    href: "/guides/negocjowanie-wynagrodzenia/",
    icon: "🤝",
  },
];
---

<Layout
  title="Poradniki - Wynagrodzenia, Podatki, ZUS | KalkulatorWynagrodzen.pl"
  description="Poradniki i przewodniki dotyczące wynagrodzeń w Polsce: progi podatkowe PIT, składki ZUS, składka zdrowotna, kwota wolna, B2B vs etat i więcej."
  canonical="/guides/"
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-8 text-sm text-[var(--color-muted)]">
    <ol class="flex items-center gap-2">
      <li><a href="/" class="hover:text-[var(--color-primary)] transition-colors">Strona główna</a></li>
      <li class="before:content-['/'] before:mx-2">Poradniki</li>
    </ol>
  </nav>

  <section class="max-w-4xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
      Poradniki <span class="text-[var(--color-primary)]">wynagrodzeń</span>
    </h1>
    <p class="text-lg text-[var(--color-muted)] mb-10 max-w-2xl">
      Przystępne przewodniki po podatkach, składkach ZUS i wynagrodzeniach w Polsce.
      Dowiedz się, jak obliczyć pensję netto i zoptymalizować swoje finanse.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {guides.map((guide) => (
        <a
          href={guide.href}
          class="card p-6 hover:shadow-md hover:border-[var(--color-primary)] transition-all duration-200 group block"
        >
          <div class="text-3xl mb-3">{guide.icon}</div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors mb-2">
            {guide.title}
          </h2>
          <p class="text-[var(--color-muted)] text-sm">{guide.description}</p>
          <span class="inline-block mt-4 text-sm font-semibold text-[var(--color-primary)] group-hover:underline">
            Czytaj dalej &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Schema.org BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://kalkulatorwynagrodzen.pl/" },
      { "@type": "ListItem", "position": 2, "name": "Poradniki", "item": "https://kalkulatorwynagrodzen.pl/guides/" }
    ]
  })} />
</Layout>

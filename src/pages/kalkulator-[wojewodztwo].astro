---
import Layout from "../layouts/Layout.astro";
import Calculator from "../components/Calculator.tsx";
import { wojewodztwaData } from "../lib/wojewodztwa-data.ts";
import { wynagrodzeniaData } from "../lib/wynagrodzenia-data.ts";

export function getStaticPaths() {
  return wojewodztwaData.map((w) => ({
    params: { wojewodztwo: w.slug },
    props: { data: w },
  }));
}

const { data } = Astro.props;

function formatPLN(value: number): string {
  return value.toLocaleString("pl-PL", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }) + " zł";
}

function formatNumber(value: number): string {
  return value.toLocaleString("pl-PL");
}

const siteUrl = "https://kalkulatorwynagrodzen.pl";
const pageUrl = `${siteUrl}/kalkulator-${data.slug}/`;

const otherWojewodztwa = wojewodztwaData.filter((w) => w.slug !== data.slug);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Kalkulator Wynagrodzeń",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": `Kalkulator ${data.name}`,
      "item": pageUrl,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faq.map((f: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `Kalkulator wynagrodzeń ${data.name} 2026`,
  "description": data.description,
  "url": pageUrl,
  "inLanguage": "pl-PL",
  "about": {
    "@type": "Place",
    "name": `Województwo ${data.name}`,
    "address": {
      "@type": "PostalAddress",
      "addressRegion": data.name,
      "addressCountry": "PL",
    },
  },
};
---

<Layout
  title={`Kalkulator wynagrodzeń ${data.name} 2026 - Brutto Netto ${data.capital}`}
  description={data.description}
  canonical={`/kalkulator-${data.slug}/`}
>
  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1">
      <li><a href="/" class="hover:text-[var(--color-primary)] transition-colors">Kalkulator</a></li>
      <li class="before:content-['›'] before:mx-1">
        <span class="text-gray-700 font-medium">Woj. {data.name}</span>
      </li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="text-center mb-10">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
      Kalkulator wynagrodzeń <span class="text-[var(--color-primary)]">{data.name}</span> 2026
    </h1>
    <p class="text-lg text-[var(--color-muted)] max-w-2xl mx-auto">
      Oblicz wynagrodzenie netto z brutto w województwie {data.nameLocative}.
      Średnie wynagrodzenie: <strong>{formatNumber(data.averageSalary)} PLN brutto</strong>.
      Stolica: {data.capital}. Populacja: {data.population}.
    </p>
  </section>

  <!-- Kalkulator -->
  <section id="kalkulator" class="mb-10">
    <Calculator client:idle />
  </section>

  <!-- Kontekst regionalny -->
  <article class="prose prose-lg max-w-4xl mx-auto mb-10">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">
      Rynek pracy w województwie {data.nameLocative}
    </h2>
    <p>{data.economicContext}</p>

    <h3 class="text-xl font-bold text-gray-800 mb-3 mt-8">
      Kluczowe branże w województwie {data.nameLocative}
    </h3>
    <ul>
      {data.keyIndustries.map((industry: string) => (
        <li><strong>{industry}</strong></li>
      ))}
    </ul>

    <h3 class="text-xl font-bold text-gray-800 mb-3 mt-8">
      Średnie wynagrodzenie w województwie {data.nameLocative}
    </h3>
    <p>
      Średnie wynagrodzenie brutto w województwie {data.nameLocative} w 2026 roku wynosi około
      <strong>{formatNumber(data.averageSalary)} PLN</strong> miesięcznie. Oznacza to, że przeciętny
      pracownik w regionie otrzymuje na rękę netto nieco ponad {formatNumber(Math.round(data.averageSalary * 0.73))} PLN.
      Wynagrodzenia różnią się jednak znacząco w zależności od branży, stanowiska i wielkości firmy.
      W stolicy województwa - {data.capital} - zarobki są zazwyczaj wyższe niż w pozostałych miastach regionu.
    </p>
    <p>
      Warto pamiętać, że składki ZUS, zdrowotna i podatek PIT są jednakowe w całej Polsce -
      nie zależą od województwa. Różnice regionalne dotyczą przede wszystkim poziomu wynagrodzeń
      oferowanych przez pracodawców oraz kosztów życia. Kalkulator powyżej pozwala obliczyć
      netto z dowolnej kwoty brutto, niezależnie od lokalizacji.
    </p>
  </article>

  <!-- Tabela przykładowych wynagrodzeń -->
  <section class="mb-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Popularne wynagrodzenia brutto-netto w woj. {data.nameLocative}
      </h2>
      <div class="card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-200">
                <th class="text-left py-3 px-4 font-semibold text-gray-600">Brutto</th>
                <th class="text-right py-3 px-4 font-semibold text-gray-600">ZUS</th>
                <th class="text-right py-3 px-4 font-semibold text-gray-600">Zdrowotna</th>
                <th class="text-right py-3 px-4 font-semibold text-gray-600">PIT</th>
                <th class="text-right py-3 px-4 font-semibold text-green-700">Netto</th>
              </tr>
            </thead>
            <tbody>
              {wynagrodzeniaData.map((w) => (
                <tr class={`border-b border-gray-100 hover:bg-gray-50 ${Math.abs(w.brutto - data.averageSalary) < 1000 ? 'bg-red-50 font-semibold' : ''}`}>
                  <td class="py-2.5 px-4">
                    <a href={`/wynagrodzenie-${w.slug}-brutto-netto/`} class="text-[var(--color-primary)] hover:underline">
                      {formatNumber(w.brutto)} PLN
                    </a>
                    {Math.abs(w.brutto - data.averageSalary) < 1000 && (
                      <span class="text-xs text-[var(--color-primary)] ml-1">≈ średnia</span>
                    )}
                  </td>
                  <td class="py-2.5 px-4 text-right text-red-600">-{formatPLN(w.zusRazem)}</td>
                  <td class="py-2.5 px-4 text-right text-red-600">-{formatPLN(w.zdrowotna)}</td>
                  <td class="py-2.5 px-4 text-right text-red-600">-{formatPLN(w.pit)}</td>
                  <td class="py-2.5 px-4 text-right text-green-700 font-semibold">{formatPLN(w.netto)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mb-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Najczęściej zadawane pytania - województwo {data.name.toLowerCase()}
      </h2>
      <div class="space-y-4">
        {data.faq.map((f: { question: string; answer: string }) => (
          <details class="card p-5 group">
            <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between">
              <span>{f.question}</span>
              <span class="text-[var(--color-primary)] text-xl ml-4 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-links do innych województw -->
  <section class="mb-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-gray-900 mb-4">
        Kalkulator wynagrodzeń w innych województwach
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        {otherWojewodztwa.map((w) => (
          <a
            href={`/kalkulator-${w.slug}/`}
            class="card p-4 hover:border-[var(--color-primary)] hover:shadow-md transition-all"
          >
            <p class="font-bold text-[var(--color-primary)]">Woj. {w.name}</p>
            <p class="text-sm text-[var(--color-muted)]">Stolica: {w.capital}</p>
            <p class="text-sm text-[var(--color-muted)]">Średnia: {formatNumber(w.averageSalary)} PLN brutto</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-links do wynagrodzeń -->
  <section class="mb-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-gray-900 mb-4">
        Popularne kwoty brutto-netto
      </h2>
      <div class="flex flex-wrap gap-2">
        {wynagrodzeniaData.map((w) => (
          <a
            href={`/wynagrodzenie-${w.slug}-brutto-netto/`}
            class="text-sm px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-50 hover:text-[var(--color-primary)] transition-colors"
          >
            {formatNumber(w.brutto)} PLN
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Źródła -->
  <section class="mt-12 pt-8 border-t border-gray-200">
    <h3 class="text-sm font-semibold text-gray-700 mb-2">Źródła</h3>
    <ul class="text-xs text-gray-500 space-y-1">
      <li><a href="https://www.podatki.gov.pl" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-primary)] transition-colors">Podatki.gov.pl</a> — Ministerstwo Finansów, stawki PIT i progi podatkowe</li>
      <li><a href="https://www.zus.pl" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-primary)] transition-colors">ZUS</a> — Zakład Ubezpieczeń Społecznych, składki ubezpieczeniowe</li>
    </ul>
  </section>
</Layout>

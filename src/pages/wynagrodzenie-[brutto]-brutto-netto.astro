---
import Layout from "../layouts/Layout.astro";
import Calculator from "../components/Calculator.tsx";
import { wynagrodzeniaData } from "../lib/wynagrodzenia-data.ts";

export function getStaticPaths() {
  return wynagrodzeniaData.map((w) => ({
    params: { brutto: w.slug },
    props: { data: w },
  }));
}

const { data } = Astro.props;

function formatPLN(value: number): string {
  return value.toLocaleString("pl-PL", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }) + " zł";
}

function formatNumber(value: number): string {
  return value.toLocaleString("pl-PL");
}

const siteUrl = "https://kalkulatorwynagrodzen.pl";
const pageUrl = `${siteUrl}/wynagrodzenie-${data.slug}-brutto-netto/`;

const otherSalaries = wynagrodzeniaData.filter((w) => w.slug !== data.slug);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Kalkulator Wynagrodzeń",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": `${formatNumber(data.brutto)} PLN brutto netto`,
      "item": pageUrl,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faq.map((f: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};
---

<Layout
  title={`${formatNumber(data.brutto)} PLN brutto ile to netto 2026 - Kalkulator`}
  description={data.description}
  canonical={`/wynagrodzenie-${data.slug}-brutto-netto/`}
>
  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1">
      <li><a href="/" class="hover:text-[var(--color-primary)] transition-colors">Kalkulator</a></li>
      <li class="before:content-['›'] before:mx-1">
        <span class="text-gray-700 font-medium">{formatNumber(data.brutto)} PLN brutto netto</span>
      </li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="text-center mb-10">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
      <span class="text-[var(--color-primary)]">{formatNumber(data.brutto)} PLN</span> brutto - ile to netto w 2026?
    </h1>
    <p class="text-lg text-[var(--color-muted)] max-w-2xl mx-auto">
      {data.description}
    </p>
  </section>

  <!-- Główne kwoty -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
    <div class="card p-5 text-center">
      <p class="text-sm text-[var(--color-muted)] mb-1">Brutto</p>
      <p class="text-2xl font-bold text-gray-800">{formatPLN(data.brutto)}</p>
      <p class="text-xs text-[var(--color-muted)]">rocznie: {formatPLN(data.brutto * 12)}</p>
    </div>
    <div class="card p-5 text-center border-2 border-[var(--color-primary)]">
      <p class="text-sm text-[var(--color-muted)] mb-1">Netto (na rękę)</p>
      <p class="text-3xl font-bold text-[var(--color-primary)]">{formatPLN(data.netto)}</p>
      <p class="text-xs text-[var(--color-muted)]">rocznie: {formatPLN(data.netto * 12)}</p>
    </div>
    <div class="card p-5 text-center">
      <p class="text-sm text-[var(--color-muted)] mb-1">Koszt pracodawcy</p>
      <p class="text-2xl font-bold text-gray-800">{formatPLN(data.kosztPracodawcy)}</p>
      <p class="text-xs text-[var(--color-muted)]">rocznie: {formatPLN(data.kosztPracodawcy * 12)}</p>
    </div>
  </section>

  <!-- Szczegółowa tabela -->
  <section class="mb-10">
    <div class="card p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Szczegółowy rozkład wynagrodzenia {formatNumber(data.brutto)} PLN brutto
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="text-left py-3 pr-4 text-gray-600 font-semibold">Składnik</th>
              <th class="text-right py-3 text-gray-600 font-semibold">Kwota miesięczna</th>
              <th class="text-right py-3 pl-4 text-gray-600 font-semibold">Kwota roczna</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100 bg-gray-50 font-semibold">
              <td class="py-3 pr-4">Wynagrodzenie brutto</td>
              <td class="py-3 text-right">{formatPLN(data.brutto)}</td>
              <td class="py-3 text-right pl-4">{formatPLN(data.brutto * 12)}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 pl-4 text-gray-600">Składka emerytalna (9,76%)</td>
              <td class="py-2.5 text-right text-red-600">-{formatPLN(data.emerytalne)}</td>
              <td class="py-2.5 text-right pl-4 text-red-600">-{formatPLN(data.emerytalne * 12)}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 pl-4 text-gray-600">Składka rentowa (1,5%)</td>
              <td class="py-2.5 text-right text-red-600">-{formatPLN(data.rentowe)}</td>
              <td class="py-2.5 text-right pl-4 text-red-600">-{formatPLN(data.rentowe * 12)}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 pl-4 text-gray-600">Składka chorobowa (2,45%)</td>
              <td class="py-2.5 text-right text-red-600">-{formatPLN(data.chorobowe)}</td>
              <td class="py-2.5 text-right pl-4 text-red-600">-{formatPLN(data.chorobowe * 12)}</td>
            </tr>
            <tr class="border-b border-gray-200 font-semibold">
              <td class="py-3 pr-4 pl-4">Składki ZUS łącznie (13,71%)</td>
              <td class="py-3 text-right text-red-600">-{formatPLN(data.zusRazem)}</td>
              <td class="py-3 text-right pl-4 text-red-600">-{formatPLN(data.zusRazem * 12)}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 pl-4 text-gray-600">Podstawa zdrowotna</td>
              <td class="py-2.5 text-right">{formatPLN(data.podstawaZdrowotna)}</td>
              <td class="py-2.5 text-right pl-4">{formatPLN(data.podstawaZdrowotna * 12)}</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-2.5 pr-4 pl-4 text-gray-600 font-semibold">Składka zdrowotna (9%)</td>
              <td class="py-2.5 text-right text-red-600 font-semibold">-{formatPLN(data.zdrowotna)}</td>
              <td class="py-2.5 text-right pl-4 text-red-600 font-semibold">-{formatPLN(data.zdrowotna * 12)}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 pl-4 text-gray-600">Koszty uzyskania przychodu</td>
              <td class="py-2.5 text-right">{formatPLN(data.kosztyUzyskania)}</td>
              <td class="py-2.5 text-right pl-4">{formatPLN(data.kosztyUzyskania * 12)}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 pl-4 text-gray-600">Podstawa opodatkowania</td>
              <td class="py-2.5 text-right">{formatPLN(data.podstawaOpodatkowania)}</td>
              <td class="py-2.5 text-right pl-4">{formatPLN(data.podstawaOpodatkowania * 12)}</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-2.5 pr-4 pl-4 text-gray-600 font-semibold">Zaliczka na PIT</td>
              <td class="py-2.5 text-right text-red-600 font-semibold">-{formatPLN(data.pit)}</td>
              <td class="py-2.5 text-right pl-4 text-red-600 font-semibold">-{formatPLN(data.pit * 12)}</td>
            </tr>
            <tr class="bg-green-50 font-bold text-lg">
              <td class="py-4 pr-4">Wynagrodzenie netto</td>
              <td class="py-4 text-right text-green-700">{formatPLN(data.netto)}</td>
              <td class="py-4 text-right pl-4 text-green-700">{formatPLN(data.netto * 12)}</td>
            </tr>
            <tr class="border-t-2 border-gray-300">
              <td class="py-3 pr-4 font-semibold text-gray-600">Koszt pracodawcy</td>
              <td class="py-3 text-right font-semibold">{formatPLN(data.kosztPracodawcy)}</td>
              <td class="py-3 text-right pl-4 font-semibold">{formatPLN(data.kosztPracodawcy * 12)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-6 p-4 bg-gray-50 rounded-lg">
        <p class="text-sm text-[var(--color-muted)]">
          <strong>Efektywna stawka podatkowa:</strong>{" "}
          <span class="text-[var(--color-primary)] font-bold text-lg">{data.efektywnaStawka}%</span>
          - tyle procent wynagrodzenia brutto przeznaczane jest na składki i podatki.
        </p>
      </div>
    </div>
  </section>

  <!-- Kontekst -->
  <article class="prose prose-lg max-w-4xl mx-auto mb-10">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">
      {formatNumber(data.brutto)} PLN brutto - co warto wiedzieć?
    </h2>
    <p>{data.context}</p>

    <h3 class="text-xl font-bold text-gray-800 mb-3 mt-8">
      Jak obliczono netto z {formatNumber(data.brutto)} PLN brutto?
    </h3>
    <p>
      Obliczenie netto z wynagrodzenia {formatNumber(data.brutto)} PLN brutto przebiega w kilku krokach.
      Najpierw od kwoty brutto odejmujemy składki na ubezpieczenia społeczne ZUS: emerytalną ({formatPLN(data.emerytalne)}),
      rentową ({formatPLN(data.rentowe)}) i chorobową ({formatPLN(data.chorobowe)}), co daje łącznie {formatPLN(data.zusRazem)}.
      Następnie od podstawy {formatPLN(data.podstawaZdrowotna)} obliczana jest składka zdrowotna 9%, czyli {formatPLN(data.zdrowotna)}.
      Podstawa opodatkowania to {formatPLN(data.podstawaOpodatkowania)}, od której naliczany jest podatek PIT.
      Zaliczka na PIT po odliczeniu ulgi podatkowej wynosi {formatPLN(data.pit)}.
      Końcowe netto to {formatPLN(data.brutto)} - {formatPLN(data.zusRazem)} - {formatPLN(data.zdrowotna)} - {formatPLN(data.pit)} = <strong>{formatPLN(data.netto)}</strong>.
    </p>
  </article>

  <!-- Kalkulator -->
  <section id="kalkulator" class="mb-10">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
      Oblicz inne wynagrodzenie
    </h2>
    <Calculator client:idle />
  </section>

  <!-- FAQ -->
  <section class="mb-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Najczęściej zadawane pytania - {formatNumber(data.brutto)} PLN brutto
      </h2>
      <div class="space-y-4">
        {data.faq.map((f: { question: string; answer: string }) => (
          <details class="card p-5 group">
            <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between">
              <span>{f.question}</span>
              <span class="text-[var(--color-primary)] text-xl ml-4 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-links -->
  <section class="mb-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Inne popularne wynagrodzenia brutto-netto
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {otherSalaries.map((w) => (
          <a
            href={`/wynagrodzenie-${w.slug}-brutto-netto/`}
            class="card p-4 text-center hover:border-[var(--color-primary)] hover:shadow-md transition-all"
          >
            <p class="font-bold text-[var(--color-primary)]">{formatNumber(w.brutto)} PLN</p>
            <p class="text-xs text-[var(--color-muted)]">netto: {formatPLN(w.netto)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-links do regionów -->
  <section class="mb-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-gray-900 mb-4">
        Kalkulator wynagrodzeń wg województw
      </h2>
      <div class="flex flex-wrap gap-2">
        <a href="/kalkulator-mazowieckie/" class="text-sm px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-50 hover:text-[var(--color-primary)] transition-colors">Mazowieckie</a>
        <a href="/kalkulator-malopolskie/" class="text-sm px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-50 hover:text-[var(--color-primary)] transition-colors">Małopolskie</a>
        <a href="/kalkulator-slaskie/" class="text-sm px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-50 hover:text-[var(--color-primary)] transition-colors">Śląskie</a>
        <a href="/kalkulator-wielkopolskie/" class="text-sm px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-50 hover:text-[var(--color-primary)] transition-colors">Wielkopolskie</a>
        <a href="/kalkulator-dolnoslaskie/" class="text-sm px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-50 hover:text-[var(--color-primary)] transition-colors">Dolnośląskie</a>
        <a href="/kalkulator-pomorskie/" class="text-sm px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-50 hover:text-[var(--color-primary)] transition-colors">Pomorskie</a>
      </div>
    </div>
  </section>
</Layout>
